{
  "name": "hvworkflow",
  "private": true,
  "version": "0.1.0",
  "description": "HV-Tool: end-to-end Q&A workflow for the general meeting of one DAX company.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "gates": "pnpm contract:lint && pnpm -r typecheck && pnpm -r lint && pnpm -r test && pnpm vocabulary && pnpm arch && pnpm role-literals && pnpm now-check && pnpm plan-honesty && pnpm --filter @hv/web build",
    "contract:types": "openapi-typescript packages/contract/openapi.yaml -o packages/contract/src/types.ts",
    "contract:lint": "redocly lint packages/contract/openapi.yaml",
    "vocabulary": "node scripts/vocabulary-check.mjs",
    "arch": "depcruise --config scripts/dependency-cruiser.cjs apps/web/src apps/api/src packages/domain/src",
    "role-literals": "node scripts/role-literal-check.mjs",
    "now-check": "node scripts/now-check.mjs",
    "plan-honesty": "node scripts/plan-honesty.mjs",
    "audit:check": "node scripts/audit-check.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "^2.0.0",
    "dependency-cruiser": "^18.4.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
