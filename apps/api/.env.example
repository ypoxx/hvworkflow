# Configuration of the HV-Tool API (slice 034b). One entry per variable of the configuration schema
# (apps/api/src/config/schema.ts); a test compares this file with the schema in both directions.
# The service checks every variable before it opens a socket and refuses to start with a fixed
# sentence that names the variable, never its value. An empty value counts as "not set", except where
# noted. Secrets stay empty here: "from the platform" means the deployment supplies them (slice 037).

# Port of the HTTP server, integer 1 to 65535. Default 8787.
PORT=8787

# Demo mode with synthetic data and the X-Actor header: exactly 1, or leave it out. Any other value
# (also 0) stops the start. Never together with HV_OIDC_ISSUER.
# HV_DEMO=1

# Postgres connection URL of the runtime role (postgres:// or postgresql://). Secret: from the platform.
# Excludes HV_EVENT_LOG. Required when sign-in is configured.
HV_DATABASE_URL=

# JSON-lines development log, only with HV_DEMO=1: absolute path in an existing writable directory,
# not inside HV_ACCESS_LOG_DIR. Excludes HV_DATABASE_URL. Empty is an error, so leave it commented out.
# HV_EVENT_LOG=/path/to/hv-events.jsonl

# Verify the Postgres server certificate: 0 or 1. Default 0.
HV_DB_TLS=0

# Sign-in (OpenID Connect): all five values or none, plus HV_DATABASE_URL and the transparency notice below.
# Issuer URL: https, or http for localhost and 127.0.0.1 only, no credentials in the URL.
HV_OIDC_ISSUER=
# Client id registered with the identity provider.
HV_OIDC_CLIENT_ID=
# Client secret: from the platform.
HV_OIDC_CLIENT_SECRET=
# Redirect URI, same URL rules as the issuer; the path is /auth/callback.
HV_OIDC_REDIRECT_URI=
# Key for the session store: base64url of exactly 32 bytes, from the platform.
HV_AUTH_ENCRYPTION_KEY=

# Transparency notice shown at sign-in: version, German text and English text are all required when
# sign-in is configured; none of them may be blank.
HV_TRANSPARENCY_NOTICE_VERSION=
# German text of the transparency notice.
HV_TRANSPARENCY_NOTICE_DE=
# English text of the transparency notice.
HV_TRANSPARENCY_NOTICE_EN=
# Optional link to the data protection summary: http or https URL without credentials.
HV_DSFA_SUMMARY_URL=

# Actor of the demo auto-seed, "<id>:<role>" like the X-Actor header. Demo only. Empty is an error, so
# leave it commented out.
# HV_SEED_ACTOR=seed-actor:role

# Directory of the access log: required outside demo mode, must exist and be writable, must be a real
# directory (no symlink), no write for the group and nothing for others (0700 or 0750).
HV_ACCESS_LOG_DIR=
# HMAC key for hashed subjects in the access log: base64, at least 32 bytes, from the platform.
# Required outside demo mode. Empty is an error.
HV_ACCESS_LOG_HASH_KEY=
# Retention of access log files in days, integer 1 to 365. Default 30. Empty is an error.
HV_ACCESS_LOG_RETENTION_DAYS=30

# Servers for the clock check of /readyz: one to three host[:port] or [v6]:port, comma separated.
# Default: none (the clock check then reports not_configured).
HV_NTP_SERVERS=
# Largest accepted clock drift in milliseconds, integer 50 to 60000. Default 1000. Empty is an error.
HV_CLOCK_MAX_DRIFT_MS=1000

# Bearer token of GET /metrics: at least 32 characters, from the platform. Empty: /metrics answers 401.
HV_METRICS_TOKEN=

# Allowed CORS origins, comma separated, at most 10, each scheme://host[:port] without path, wildcard or
# null; outside demo mode https only. Default: http://localhost:5173 in demo mode, otherwise none.
HV_CORS_ORIGINS=

# Trusted proxies as IPv4 or IPv6 CIDR blocks, comma separated, at most 16, no host bits, IPv4 from /8 and
# IPv6 from /32 (so never /0); a block inside ::ffff:0:0/96 counts as its IPv4 block. Only a connection from
# such a block may name the client through X-Forwarded-For. Default: none.
HV_TRUSTED_PROXY_CIDRS=

# Request timeout in milliseconds (answer 408), integer 7000 to 60000. Default 10000.
HV_REQUEST_TIMEOUT_MS=10000

# Requests per minute and subject for writes, integer 1 to 10000. Default 60.
HV_RATE_LIMIT_WRITES_PER_MIN=60
# Requests per minute and subject for reads, integer 60 to 100000. Default 1200.
HV_RATE_LIMIT_READS_PER_MIN=1200
# Requests per minute and source without sign-in, integer 10 to 100000. Default 600.
HV_RATE_LIMIT_ANON_PER_MIN=600
# Sign-in starts per minute and source, integer 1 to 10000. Default 120.
HV_RATE_LIMIT_LOGIN_PER_MIN=120
# Sign-in starts per minute over all sources, integer 10 to 100000. Default 600.
HV_RATE_LIMIT_LOGIN_GLOBAL_PER_MIN=600
# Probes (/healthz, /readyz) per minute and source, integer 10 to 100000. Default 600.
HV_RATE_LIMIT_PROBES_PER_MIN=600
# CORS preflights per minute and source, integer 10 to 100000. Default 1200.
HV_RATE_LIMIT_PREFLIGHT_PER_MIN=1200

# Postgres statement timeout in milliseconds, integer 500 to 60000. Default 5000.
HV_DB_STATEMENT_TIMEOUT_MS=5000
# Postgres lock timeout in milliseconds, integer 100 to 60000. Default 3000.
HV_DB_LOCK_TIMEOUT_MS=3000
# Timer per query in the service, integer 1000 to 60000. Default 6000.
HV_DB_QUERY_TIMEOUT_MS=6000
# Idle-in-transaction timeout in milliseconds, integer 1000 to 600000. Default 15000.
# The five time limits must be in this order: lock < statement < query < request < idle.
HV_DB_IDLE_TX_TIMEOUT_MS=15000
